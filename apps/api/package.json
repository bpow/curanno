{
  "name": "@scale/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify server implementing the W3C Web Annotation Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "spike:glue": "node --experimental-strip-types spike/glue.ts",
    "spike:manual": "node --experimental-strip-types spike/manual.ts"
  },
  "dependencies": {
    "@scale/model": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-openapi-glue": "^4.12.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
