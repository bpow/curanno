{
  "name": "@curanno/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify server implementing the W3C Web Annotation Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.yaml",
    "migrations"
  ],
  "scripts": {
    "dev": "tsc -b && node --watch --env-file-if-exists=../../deploy/zitadel/.bootstrap/oidc.env --env-file-if-exists=../../.env dist/index.js",
    "start": "node dist/index.js",
    "spike:glue": "node --experimental-strip-types spike/glue.ts",
    "spike:manual": "node --experimental-strip-types spike/manual.ts",
    "migrate": "node --env-file-if-exists=../../.env --experimental-strip-types src/db/migrate.ts",
    "load:seed": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/load-seed.ts",
    "load:run": "tsc -b && node --env-file-if-exists=../../.env --experimental-strip-types scripts/load-run.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@curanno/api-client": "workspace:*",
    "@curanno/model": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "fastify-openapi-glue": "^4.12.0",
    "jose": "6.2.13",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/pg": "^8.23.1",
    "autocannon": "8.0.0"
  }
}
