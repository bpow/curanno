{
  "manifest_version": 3,
  "name": "CurAnno",
  "version": "0.0.0",
  "description": "Annotate web pages and PDFs with CurAnno, including pages that block the bookmarklet.",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "webNavigation", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "CurAnno: off",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
