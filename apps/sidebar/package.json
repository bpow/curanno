{
  "name": "@curanno/sidebar",
  "version": "0.0.0",
  "private": true,
  "description": "Sidebar app (Vue 3 + Vite) served from our origin in an iframe",
  "type": "module",
  "scripts": {
    "dev": "tsc -b ../../packages/model ../../packages/api-client ../../packages/extract && vite",
    "build": "tsc -b ../../packages/model ../../packages/api-client ../../packages/extract && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:guest": "playwright test -c playwright.guest.config.ts"
  },
  "dependencies": {
    "@curanno/api-client": "workspace:*",
    "@curanno/extract": "workspace:*",
    "@curanno/model": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@curanno/guest": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
  }
}
