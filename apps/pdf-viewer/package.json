{
  "name": "@curanno/pdf-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "PDF.js viewer page served from our origin, with the guest built in",
  "type": "module",
  "scripts": {
    "dev": "tsc -b ../../packages/model ../../packages/guest && vite",
    "build": "tsc -b ../../packages/model ../../packages/guest && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@curanno/guest": "workspace:*",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "vite": "^7.3.7"
  }
}
