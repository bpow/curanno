{
  "name": "@curanno/web",
  "version": "0.0.0",
  "private": true,
  "description": "Management site (Nuxt): an ordinary client of the public API",
  "type": "module",
  "scripts": {
    "dev": "tsc -b ../../packages/model ../../packages/api-client ../../packages/guest && nuxt dev --port 3001",
    "build": "tsc -b ../../packages/model ../../packages/api-client ../../packages/guest && nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@curanno/api-client": "workspace:*",
    "@curanno/guest": "workspace:*",
    "@curanno/model": "workspace:*",
    "nuxt": "~4.6.3",
    "oidc-client-ts": "^3.5.0",
    "vue": "3.5.44",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "vue-tsc": "^3.3.13"
  }
}
