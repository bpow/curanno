# Copy to .env for local development. Values match compose.yaml.
# Every setting of the API is an environment variable; the Helm chart under
# deploy/helm/curanno sets the same names.

# Postgres connection string; the only stateful dependency (ADR 0004).
# No port in the URL, so the clients take PGPORT, as compose does.
DATABASE_URL=postgres://curanno:curanno@localhost/curanno
# Host port compose publishes Postgres on (default 5432).
#PGPORT=5432

# OpenID Connect issuer; discovery runs at <issuer>/.well-known/openid-configuration (ADR 0005).
# For the compose Zitadel, leave both unset: its provisioner writes them to
# deploy/zitadel/.bootstrap/oidc.env, which the API, the sidebar's and the
# site's dev servers and the end-to-end tests fall back to. Set here, they win.
# OIDC_ISSUER=http://localhost:8080
# Host port compose serves Zitadel on (default 8080); the provisioned issuer follows it.
#ZITADEL_PORT=8080
# The client the sidebar and the site authenticate as; Zitadel generates the id.
# OIDC_CLIENT_ID=
# Accepted `aud` claim; defaults to OIDC_CLIENT_ID. Tokens whose `azp` is the
# client are accepted as well, for providers that put something else in `aud`.
#OIDC_AUDIENCE=

# Who issues the tokens (ADR 0028). `external` (the default) trusts the OpenID
# Connect provider above. `embedded` makes the API its own issuer, on
# PUBLIC_URL, with a fixed client and no Zitadel: set AUTH_MODE=embedded and
# the next lines, run `pnpm --filter @curanno/api migrate`, then create the
# first administrator with
#   pnpm --filter @curanno/api account create --login you@example.org --admin
# In development PUBLIC_URL must be the site's origin (WEB_PORT), which proxies
# /oidc and the discovery document to the API. OIDC_ISSUER and OIDC_CLIENT_ID
# are ignored in this mode.
#AUTH_MODE=embedded
# Encrypts the signing keys in the database and keys the issuer's cookies; at
# least 32 characters, the same on every replica. Keep it out of backups.
#AUTH_SECRET=
#PUBLIC_URL=http://localhost:3001
# Other origins where the clients run, for the client's redirect URIs and CORS
# (the sidebar's own dev server, which its end-to-end test uses directly).
#AUTH_EXTRA_ORIGINS=http://localhost:5173
# Browser extensions the sidebar may sign in through (ADR 0029); this is the
# id of apps/extension, which its manifest key fixes.
#AUTH_EXTENSION_IDS=dmlkjhnoiinndnkboiknehimngilddpp
# Mail for invitations, password resets and address verification. Without
# SMTP_URL nothing is sent: `account invite` prints the link to hand over, and
# "forgot password" is not offered. MAIL_FROM is required with SMTP_URL.
# (In development, a local catcher such as Mailpit on smtp://localhost:1025.)
#SMTP_URL=smtp://localhost:1025
#MAIL_FROM=curanno <no-reply@example.org>
# Who may create an account by themselves: `approval` (the default; they wait
# until an administrator approves on the Applications page), `open` (active at
# once) or `closed` (invitations only, which work under every policy).
#AUTH_SIGNUP=approval
# Under approval, applicants whose verified address is in one of these domains
# (space or comma separated) are approved without an administrator.
#AUTH_AUTO_APPROVE_DOMAINS=example.org
# Sign-up pauses while this many applications wait (default 200).
#AUTH_MAX_PENDING=200
# Sign in with another service. Each needs both values; register
# <PUBLIC_URL>/idp/upstream/<google|github|oidc>/callback as the redirect URI.
#UPSTREAM_GOOGLE_CLIENT_ID=
#UPSTREAM_GOOGLE_CLIENT_SECRET=
#UPSTREAM_GITHUB_CLIENT_ID=
#UPSTREAM_GITHUB_CLIENT_SECRET=
# Any OpenID Connect provider (its discovery document is read from the issuer).
#UPSTREAM_OIDC_ISSUER=https://sso.example.org/realms/main
#UPSTREAM_OIDC_CLIENT_ID=
#UPSTREAM_OIDC_CLIENT_SECRET=
#UPSTREAM_OIDC_NAME=Campus sign-in
# Providers whose verified email may join an existing account without asking
# for its password (off by default; only list providers that verify addresses).
#AUTH_AUTOLINK=
# While no administrator exists, this address is invited to become one: the
# invitation is mailed, or its link is logged when there is no SMTP_URL.
#BOOTSTRAP_ADMIN_EMAIL=you@example.org

# Listening port; the sidebar's and the site's dev proxies follow it.
PORT=3000
# Development servers' ports (dev-ports.ts), to move off ports another
# project holds. Set them here rather than only in the shell, so compose's
# provisioner registers the matching redirect URIs on `up`.
# Management site, and the one origin the sidebar and the API are proxied under.
#WEB_PORT=3001
# Sidebar's Vite server (proxied by the site; also used directly by its e2e suite).
#SIDEBAR_PORT=5173
#PDF_VIEWER_PORT=5174
# The guest dev script's sample page and bundle server (`just guest`).
#GUEST_PORT=5180
#GUEST_BUNDLE_PORT=5181
# Origin under which annotation IRIs are minted (default http://localhost:$PORT).
#PUBLIC_URL=http://localhost:3000
# pino level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Serving the clients from this process (ADR 0021). Unset in development, where
# each app has its own dev server; the image sets it to its static directory.
#STATIC_ROOT=/app/static
# Origins allowed to embed the sidebar, as CSP source expressions, space-separated,
# in double quotes (Node's --env-file stops a value at the closing single quote).
# The PDF viewer origin is added automatically. The sidebar's dev server reads it
# too; keep http://localhost:* http://127.0.0.1:* there for the dev pages.
#FRAME_ANCESTORS="'self' https://pages.example https://*.example.org"
# The PDF viewer's origin. The viewer is served for this host only and the
# sidebar accepts a document report from it for the PDF it shows.
#PDF_VIEWER_ORIGIN=https://pdf.curanno.example
# Prometheus metrics at /metrics; set to false to turn them off.
#METRICS_ENABLED=true
# Annotation suggestions (ADR 0032): OpenAI-compatible endpoints the sidebar may
# send document text to, as a JSON list of {label, url, models?}. Each origin is
# added to the sidebar's connect-src; unset turns suggestions off. The sidebar's
# dev server reads it too, as VITE_EXTRACT_ENDPOINTS. For Ollama on
# the curator's computer, start it with OLLAMA_ORIGINS set to the sidebar's origin.
#EXTRACT_ENDPOINTS=[{"label":"This computer (Ollama)","url":"http://localhost:11434","models":["llama3.1:8b"]}]
# Refuse to start when an endpoint is not on loopback, so document text stays on
# the curator's machine.
#EXTRACT_LOCAL_ONLY=true
