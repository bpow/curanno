{
  "realm": "annotations-dev",
  "enabled": true,
  "displayName": "Annotations (development)",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "annotations-sidebar",
      "name": "Annotations sidebar",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:4173/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "curators"
    },
    {
      "name": "reviewers"
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Annotator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "groups": ["/curators"]
    },
    {
      "username": "bob",
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Reviewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "groups": ["/reviewers"]
    }
  ]
}
