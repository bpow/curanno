{
  "name": "@curanno/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript client generated from the OpenAPI document",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.yaml -o src/schema.ts --root-types --root-types-no-schema-prefix --empty-objects-unknown --additional-properties"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
