{
  "id": "synth-duplicates",
  "title": "Deleted text with near-duplicates elsewhere (must-not-match cases)",
  "kind": "html",
  "source": {
    "license": "Written for this corpus"
  },
  "tags": ["synthetic", "mustNotMatch"],
  "variants": [
