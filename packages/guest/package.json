{
  "name": "@curanno/guest",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free in-page guest: selection, anchoring, highlights and the sidebar RPC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vue": "3.5.44"
  },
  "scripts": {
    "trial": "node trial/src/run.ts",
    "trial:build": "node trial/src/build.ts",
    "trial:highlights": "node trial/src/highlights.ts",
    "trial:a11y": "node trial/src/a11y.ts",
    "corpus:describe": "node trial/src/describe.ts",
    "corpus:pdf": "node trial/src/make-pdf.ts",
    "bundle": "node scripts/bundle.ts",
    "bookmarklet": "node scripts/bookmarklet.ts",
    "dev": "node scripts/dev.ts",
    "test:browser": "vitest run -c test/vitest.config.ts",
    "serve:corpus": "node scripts/serve-corpus.ts"
  },
  "dependencies": {
    "@curanno/model": "workspace:*",
    "approx-string-match": "2.0.1"
  }
}
