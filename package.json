{
  "name": "web-annotation-platform",
  "private": true,
  "version": "0.0.0",
  "description": "W3C Web Annotation platform: Fastify API, framework-free guest, Vue sidebar",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -b && tsc -p apps/api/spike/tsconfig.json",
    "test": "vitest run",
    "licenses:check": "node scripts/check-licenses.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm licenses:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.72.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
